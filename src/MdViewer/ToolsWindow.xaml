<Window x:Class="MdViewer.ToolsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:MdViewer.ViewModels"
 Title="Tools — md-viewer">
 <Grid x:Name="RootGrid" Background="{StaticResource BackgroundBrush}" RequestedTheme="Dark">
  <Grid.Resources>
   <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolCard">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18">
     <Grid ColumnSpacing="20" RowSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock Grid.Row="1" Text="{x:Bind Purpose, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="3" Text="{x:Bind Location, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource QuietBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      <TextBlock Grid.Row="4" Text="{x:Bind LanguagesText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="5" Text="{x:Bind LatestText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Grid.RowSpan="6" VerticalAlignment="Center" Spacing="8" MaxWidth="230" Visibility="{x:Bind HasAction, Mode=OneWay}">
       <Button Content="{x:Bind ActionLabel, Mode=OneWay}" Tag="{x:Bind Id}" Click="Install_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="14,8" Visibility="{x:Bind NeedsAttention, Mode=OneWay}" />
       <Button Content="{x:Bind ActionLabel, Mode=OneWay}" Tag="{x:Bind Id}" Click="Install_Click" HorizontalAlignment="Stretch" Padding="14,8" Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
       <TextBlock Text="{x:Bind ActionNote, Mode=OneWay}" FontSize="11" Foreground="{StaticResource QuietBrush}" TextWrapping="Wrap" />
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

  <Grid x:Name="AppTitleBar" Background="{StaticResource ChromeBrush}" Padding="16,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Image Source="Assets/Square44x44Logo.png" Width="22" Height="22" />
    <TextBlock Text="MD-VIEWER" FontSize="12" CharacterSpacing="150" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
    <TextBlock Text="/  Tools" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
   </StackPanel>
  </Grid>

  <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Padding="28,24,28,28" Spacing="16" MaxWidth="860" HorizontalAlignment="Stretch">
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Spacing="6">
      <TextBlock Text="Tools" FontSize="28" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock Text="md-viewer uses these programs for conversion and OCR. They are installed separately, and md-viewer checks them against their official releases on GitHub." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
     </StackPanel>
     <Button Grid.Column="1" Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" VerticalAlignment="Top" Padding="14,8" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="18">
     <CheckBox Content="Check for updates once a day" IsChecked="{x:Bind ViewModel.CheckAutomatically, Mode=TwoWay}" />
     <TextBlock Text="{x:Bind ViewModel.LastChecked, Mode=OneWay}" FontSize="12" Foreground="{StaticResource QuietBrush}" VerticalAlignment="Center" />
    </StackPanel>

    <ContentControl Content="{x:Bind ViewModel.Pandoc}" ContentTemplate="{StaticResource ToolCardTemplate}" HorizontalContentAlignment="Stretch" />
    <ContentControl Content="{x:Bind ViewModel.Tesseract}" ContentTemplate="{StaticResource ToolCardTemplate}" HorizontalContentAlignment="Stretch" />

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18">
     <StackPanel Spacing="12">
      <TextBlock Text="OCR for scanned PDFs" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock Text="{x:Bind ViewModel.ActiveEngineText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
      <RadioButtons Header="Engine" SelectedIndex="{x:Bind ViewModel.EngineIndex, Mode=TwoWay}">
       <x:String>Automatic: Tesseract when it is installed, otherwise Windows OCR</x:String>
       <x:String>Windows OCR</x:String>
       <x:String>Tesseract</x:String>
      </RadioButtons>
      <TextBox Header="Tesseract languages" Text="{x:Bind ViewModel.TesseractLanguages, Mode=TwoWay}" PlaceholderText="eng" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240" IsSpellCheckEnabled="False" />
      <TextBlock Text="Tesseract codes joined with +, for example eng+deu+fra. Add language data by running the Tesseract installer again." FontSize="11" Foreground="{StaticResource QuietBrush}" TextWrapping="Wrap" />
      <TextBlock Margin="0,6,0,0" Text="Windows OCR" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock Text="{x:Bind ViewModel.WindowsOcr.LanguagesText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.WindowsOcr.Location, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="2" Background="{StaticResource ChromeBrush}" Padding="16,6,8,6" ColumnSpacing="12" MinHeight="34">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
   <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
   <Button Grid.Column="2" Content="Stop" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay}" Padding="12,3" FontSize="12" />
  </Grid>
 </Grid>
</Window>

<Window x:Class="MdViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MdViewer.Controls"
 Title="md-viewer">
 <Grid x:Name="RootGrid" Background="{StaticResource BackgroundBrush}" RequestedTheme="Dark" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>

  <Grid x:Name="AppTitleBar" Background="{StaticResource ChromeBrush}" Padding="16,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Image Source="Assets/Square44x44Logo.png" Width="22" Height="22" AutomationProperties.Name="md-viewer" />
    <TextBlock Text="MD-VIEWER" FontSize="12" CharacterSpacing="150" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560">
     <Run Text="/  " /><Run Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" />
    </TextBlock>
    <TextBlock Text="{x:Bind ViewModel.DocumentState, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
   <CommandBar x:Name="Toolbar" HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
    <AppBarButton Icon="OpenFile" Label="Open" Command="{x:Bind ViewModel.OpenCommand}" ToolTipService.ToolTip="Open or import a document">
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarButton Icon="Save" Label="Save" Command="{x:Bind ViewModel.SaveCommand}" ToolTipService.ToolTip="Save as Markdown">
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarButton Label="Save as" Command="{x:Bind ViewModel.SaveAsCommand}" ToolTipService.ToolTip="Save a copy as Markdown">
     <AppBarButton.Icon><FontIcon Glyph="&#xE792;" /></AppBarButton.Icon>
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="S" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarButton Icon="Cancel" Label="Close" Command="{x:Bind ViewModel.CloseDocumentCommand}" ToolTipService.ToolTip="Close the document">
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="W" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarSeparator />
    <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo the last Format or Reflow (Ctrl+Z)">
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Z" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Y)">
     <AppBarButton.KeyboardAccelerators>
      <KeyboardAccelerator Modifiers="Control" Key="Y" />
      <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" />
     </AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarSeparator />
    <AppBarButton Icon="Share" Label="Export" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="Export through Pandoc: Word, HTML, EPUB, RTF, ODT, LaTeX, Typst, reStructuredText, Org">
     <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="E" /></AppBarButton.KeyboardAccelerators>
    </AppBarButton>
    <AppBarButton Icon="Globe" Label="Crawl" Command="{x:Bind ViewModel.CrawlCommand}" ToolTipService.ToolTip="Collect a documentation site into one Markdown document" />
    <AppBarSeparator />
    <AppBarButton Label="Format" Command="{x:Bind ViewModel.FormatCommand}" ToolTipService.ToolTip="Normalize the Markdown through Pandoc">
     <AppBarButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarButton.Icon>
    </AppBarButton>
    <AppBarButton Icon="Sort" Label="Reflow" Command="{x:Bind ViewModel.ReflowCommand}" ToolTipService.ToolTip="Repair skipped heading levels" />
    <AppBarSeparator />
    <AppBarToggleButton Label="Raw" IsChecked="{x:Bind ViewModel.IsRawView, Mode=TwoWay}" ToolTipService.ToolTip="Show the Markdown source (Ctrl+R)">
     <AppBarToggleButton.Icon><FontIcon Glyph="&#xE943;" /></AppBarToggleButton.Icon>
    </AppBarToggleButton>
    <CommandBar.SecondaryCommands>
     <AppBarButton Label="Tools..." Command="{x:Bind ViewModel.OpenToolsCommand}" ToolTipService.ToolTip="Pandoc and Tesseract: what is installed, updates, and OCR settings">
      <AppBarButton.Icon><FontIcon Glyph="&#xE90F;" /></AppBarButton.Icon>
     </AppBarButton>
     <AppBarButton Icon="ClosePane" Label="Exit" Command="{x:Bind ViewModel.ExitCommand}" />
    </CommandBar.SecondaryCommands>
   </CommandBar>
  </Border>
  <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="Transparent" />

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="OutlineColumn" Width="280" MinWidth="160" MaxWidth="640" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
   </Grid.ColumnDefinitions>
   <Grid Background="{StaticResource SidebarBrush}" Padding="8,18,4,10" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Padding="12,0,12,0">
     <TextBlock Text="OUTLINE" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource MutedBrush}" />
     <TextBlock Text="{x:Bind ViewModel.OutlineSummary, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource QuietBrush}" />
    </Grid>
    <TreeView Grid.Row="1" x:Name="OutlineTree" ItemInvoked="Outline_ItemInvoked" SelectionChanged="Outline_SelectionChanged" SelectionMode="Single" CanDragItems="False" AllowDrop="False" Visibility="{x:Bind ViewModel.HasOutline, Mode=OneWay}">
     <TreeView.ItemTemplate>
      <DataTemplate x:DataType="TreeViewNode">
       <TextBlock Text="{x:Bind Content.ToString()}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Content.ToString()}" />
      </DataTemplate>
     </TreeView.ItemTemplate>
    </TreeView>
    <TextBlock Grid.Row="1" Text="This document has no headings." Margin="12,4,12,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource QuietBrush}" Visibility="{x:Bind ViewModel.HasNoOutline, Mode=OneWay}" />
   </Grid>
   <controls:PaneSplitter x:Name="Splitter" Grid.Column="1" />
   <Grid Grid.Column="2">
    <controls:MarkdownView x:Name="Reader" Visibility="{x:Bind ViewModel.IsRichView, Mode=OneWay}" />
    <InfoBar x:Name="UpdateBar" Canvas.ZIndex="1" Margin="24,14,24,0" VerticalAlignment="Top" MaxWidth="760" Severity="Informational" Title="Tools"
             Message="{x:Bind ViewModel.UpdateNotice, Mode=OneWay}" IsOpen="{x:Bind ViewModel.HasUpdateNotice, Mode=OneWay}" CloseButtonClick="UpdateBar_Close">
     <InfoBar.ActionButton><Button Content="Open Tools" Command="{x:Bind ViewModel.OpenToolsCommand}" /></InfoBar.ActionButton>
    </InfoBar>
    <TextBox x:Name="RawEditor" Text="{x:Bind ViewModel.MarkdownText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             FontFamily="Cascadia Mono, Consolas" FontSize="{x:Bind ViewModel.RawFontSize, Mode=OneWay}" Padding="48,30,48,80" BorderThickness="0" Background="Transparent"
             IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Markdown source"
             Visibility="{x:Bind ViewModel.IsRawView, Mode=OneWay}">
     <TextBox.Resources>
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundReadOnly" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#D5E6DA" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#D5E6DA" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#D5E6DA" />
     </TextBox.Resources>
    </TextBox>
   </Grid>
  </Grid>

  <Grid Grid.Row="3" Background="{StaticResource ChromeBrush}" Padding="16,0,8,0" ColumnSpacing="14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" />
   <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource QuietBrush}" />
   <Button Grid.Column="2" Content="Cancel import" Command="{x:Bind ViewModel.CancelOperationCommand}" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" Padding="10,2" FontSize="11" />
   <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button Command="{x:Bind ViewModel.ZoomOutCommand}" Background="Transparent" BorderThickness="0" Padding="8,3" ToolTipService.ToolTip="Zoom out (Ctrl+Minus)" AutomationProperties.Name="Zoom out"><FontIcon Glyph="&#xE71F;" FontSize="12" /></Button>
    <Button Command="{x:Bind ViewModel.ResetZoomCommand}" Background="Transparent" BorderThickness="0" Padding="6,3" MinWidth="48" ToolTipService.ToolTip="Reset zoom (Ctrl+0)">
     <TextBlock Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
    </Button>
    <Button Command="{x:Bind ViewModel.ZoomInCommand}" Background="Transparent" BorderThickness="0" Padding="8,3" ToolTipService.ToolTip="Zoom in (Ctrl+Plus)" AutomationProperties.Name="Zoom in"><FontIcon Glyph="&#xE8A3;" FontSize="12" /></Button>
   </StackPanel>
  </Grid>

  <Grid Grid.RowSpan="4" Background="#B3050805" Visibility="{x:Bind ViewModel.IsCrawling, Mode=OneWay}">
   <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="28,24">
    <StackPanel Spacing="16">
     <TextBlock Text="Crawling documentation" FontSize="20" FontFamily="Segoe UI Variable Display" Foreground="{StaticResource TextBrush}" />
     <ProgressBar IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
     <TextBlock Text="{x:Bind ViewModel.CrawlStatus, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" MaxLines="4" Foreground="{StaticResource MutedBrush}" />
     <TextBlock Text="One page at a time, at least two seconds apart, honoring robots.txt, up to 250 pages." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource QuietBrush}" />
     <Button Content="Cancel" Command="{x:Bind ViewModel.CancelOperationCommand}" HorizontalAlignment="Right" />
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
